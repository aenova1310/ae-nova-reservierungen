# ─── Datenbank ────────────────────────────────────────────────────────────────
# PostgreSQL 14+ (Erweiterung btree_gist wird von der Migration aktiviert)
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova"
# Nur für Integrationstests (eigene, leere Datenbank!)
TEST_DATABASE_URL="postgresql://nova:nova@localhost:5432/nova_test"

# ─── App ──────────────────────────────────────────────────────────────────────
# Öffentliche Basis-URL (für Links in E-Mails und Embed-Code), ohne Slash am Ende
APP_URL="http://localhost:3000"
# Geheimnis für signierte Verwaltungslinks – mind. 32 Zeichen, z. B.: openssl rand -base64 48
# ACHTUNG: Ändern macht alle bisherigen Storno-/Änderungslinks ungültig.
APP_SECRET="bitte-ersetzen-mindestens-32-zeichen-lang-xxxxxxxx"
# Absicherung der Cron-Endpunkte (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="bitte-ersetzen"

# ─── E-Mail (Resend) ──────────────────────────────────────────────────────────
# Leer lassen in der Entwicklung: Mails landen dann als HTML in .mail-outbox/
RESEND_API_KEY=""
# Absender – Domain in Resend mit Region eu-west-1 verifizieren
EMAIL_FROM="A&E NOVA Reservierungen <reservierung@mail.example.de>"

# ─── Medien (Logos, Tischfotos, 360°-Panoramen) ──────────────────────────────
# "local" = Dateisystem (Entwicklung; im Container ein Volume einhängen!)
# "s3"    = S3-kompatibler Speicher, z. B. Hetzner Object Storage (empfohlen für Produktion)
MEDIA_DRIVER="local"
MEDIA_LOCAL_DIR=".media"
# Nur bei MEDIA_DRIVER="s3" – Bucket privat lassen, Auslieferung erfolgt über /media/…
# Hetzner: Endpoint https://fsn1.your-objectstorage.com (bzw. nbg1/hel1), Region = Standort
S3_ENDPOINT=""
S3_REGION="fsn1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Seed (optional) ──────────────────────────────────────────────────────────
SEED_DEMO_PASSWORD="pastahaus-demo"
SEED_ADMIN_PASSWORD="nova-superadmin"
